{
    "@import": "./element.php",
    "name": "yandex-map_item",
    "title": "Yandex Map Item",
    "width": 500,
    "defaults": {
        "location": "51.533562,46.034266",
        "popup_position": "top",
        "popup_padding": "uk-padding",
        "popup_padding_remove_vertical": true
    },
    "fields": {
        "location": {
            "label": "Location",
            "type": "text",
            "source": true,
            "attrs": {
                "class": "uk-margin-small-top",
                "uk-yandexmaplocation": ""
            }
        },
        "title": {
            "label": "Title",
            "source": true
        },
        "meta": {
            "label": "Meta",
            "source": true
        },
        "content": {
            "label": "Content",
            "type": "editor",
            "source": true
        },
        "image": "${builder.image}",
        "image_alt": {
            "label": "Image Alt",
            "source": true,
            "enable": "image"
        },
        "link": "${builder.link}",
        "link_text": {
            "label": "Link Text",
            "description": "Set a different link text for this item.",
            "source": true,
            "enable": "link"
        },
        "link_aria_label": {
            "label": "Link ARIA Label",
            "description": "Set a different link ARIA label for this item.",
            "source": true,
            "enable": "link"
        },
        "marker_icon": {
            "label": "Marker Icon",
            "type": "image",
            "source": true
        },
        "marker_icon_width": {
            "label": "Width",
            "type": "number",
            "attrs": {
                "placeholder": "auto"
            },
            "enable": "marker_icon"
        },
        "marker_icon_height": {
            "label": "Height",
            "type": "number",
            "attrs": {
                "placeholder": "auto"
            },
            "enable": "marker_icon"
        },
        "marker_color": {
            "label": "Marker Color",
            "type": "color"
        },
        "marker_icon_offset_x": {
            "label": "Horizontal Offset",
            "type": "number",
            "attrs": {
                "placeholder": "auto"
            },
            "enable": "marker_icon"
        },
        "marker_icon_offset_y": {
            "label": "Vertical Offset",
            "type": "number",
            "attrs": {
                "placeholder": "auto"
            },
            "enable": "marker_icon"
        },
        "marker_icon_loading": {
            "label": "Loading",
            "description": "By default, images are loaded lazy.<br><br>Enable eager loading for images in the initial viewport",
            "type": "checkbox",
            "text": "Load image eagerly",
            "enable": "marker_icon"
        },
        "marker_icon_border": {
            "label": "Border",
            "description": "Select the image border style.",
            "type": "select",
            "options": {
                "None": "",
                "Rounded": "rounded",
                "Circle": "circle",
                "Pill": "pill"
            },
            "enable": "marker_icon"
        },
        "hide": {
            "label": "Marker",
            "type": "checkbox",
            "text": "Hide"
        },
        "hide_popup": {
            "label": "Popup",
            "type": "checkbox",
            "text": "Hide"
        },
        "show_popup": {
            "label": "Behavior",
            "type": "checkbox",
            "text": "Show popup on load"
        },
        "popup_position": {
            "label": "Position",
            "description": "Set popup position relative to marker",
            "type": "select",
            "options": {
                "Top": "top",
                "Left": "left",
                "Right": "right"
            },
            "default": "top"
        },
        "popup_min_width": {
            "label": "Min Width",
            "description": "Set the minimum width of popup container",
            "attrs": {
                "placeholder": "px, %, vw, vh, em, rem"
            }
        },
        "popup_max_width": {
            "label": "Max Width",
            "description": "Set the maximum width of popup container",
            "attrs": {
                "placeholder": "px, %, vw, vh, em, rem"
            }
        },
        "popup_padding": {
            "label": "Padding",
            "description": "Set padding of popup container",
            "type": "select",
            "options": {
                "None": "",
                "uk-padding-small": "uk-padding-small",
                "uk-padding": "uk-padding",
                "uk-padding-large": "uk-padding-large"
            }
        },
        "popup_padding_remove_top": {
            "label": "uk-padding-remove-top",
            "type": "checkbox"
        },
        "popup_padding_remove_bottom": {
            "label": "uk-padding-remove-bottom",
            "type": "checkbox"
        },
        "popup_padding_remove_left": {
            "label": "uk-padding-remove-left",
            "type": "checkbox"
        },
        "popup_padding_remove_right": {
            "label": "uk-padding-remove-right",
            "type": "checkbox"
        },
        "popup_padding_remove_horizontal": {
            "label": "uk-padding-remove-horizontal",
            "type": "checkbox"
        },
        "popup_padding_remove_vertical": {
            "label": "uk-padding-remove-vertical",
            "type": "checkbox"
        },
        "status": "${builder.statusItem}",
        "source": "${builder.source}"
    },
    "fieldset": {
        "default": {
            "type": "tabs",
            "fields": [
                {
                    "title": "Content",
                    "fields": [
                        "location",
                        "title",
                        "meta",
                        "content",
                        "image",
                        "image_alt",
                        "link",
                        "link_text",
                        "link_aria_label",
                        "marker_icon",
                        {
                            "description": "Setting just one value preserves the original proportions.<br><br>The image will be resized and cropped automatically, and where possible, high resolution images will be auto-generated",
                            "name": "_marker_dimension",
                            "type": "grid",
                            "width": "1-3",
                            "fields": ["marker_icon_width", "marker_icon_height", "marker_color"]
                        },
                        {
                            "name": "_marker_offsets",
                            "type": "grid",
                            "width": "1-2",
                            "fields": ["marker_icon_offset_x", "marker_icon_offset_y"]
                        },
                        "marker_icon_loading",
                        "marker_icon_border"
                    ]
                },
                {
                    "title": "Settings",
                    "fields": [
                        {
                            "label": "Marker",
                            "type": "group",
                            "divider": true,
                            "fields": ["hide"]
                        },
                        {
                            "label": "Popup",
                            "type": "group",
                            "divider": true,
                            "fields": ["hide_popup", "show_popup", "popup_position", "popup_min_width", "popup_max_width"]
                        },
                        {
                            "label": "Padding",
                            "type": "group",
                            "fields": [
                                "popup_padding",
                                "popup_padding_remove_top",
                                "popup_padding_remove_bottom",
                                "popup_padding_remove_left",
                                "popup_padding_remove_right",
                                "popup_padding_remove_horizontal",
                                "popup_padding_remove_vertical"
                            ]
                        }
                    ]
                },
                "${builder.advancedItem}"
            ]
        }
    }
}
